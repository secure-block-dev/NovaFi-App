# Backend API base URL (no trailing slash).
# Defaults to http://localhost:1357 when unset — fine for local development.
REACT_APP_API_URL=http://localhost:1357

# WalletConnect (QR / mobile) project ID from https://cloud.reown.com
# Optional: injected wallets (MetaMask, Rabby, etc.) work without it.
REACT_APP_WC_PROJECT_ID=b570d67893323279d7e203daf4b0948d
